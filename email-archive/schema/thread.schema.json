{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://email.bucklerfamily.estate/schema/thread.schema.json",
  "title": "Public email evidence thread",
  "type": "object",
  "required": [
    "id",
    "subject",
    "description",
    "correspondenceWith",
    "organisation",
    "category",
    "version",
    "updatedAt",
    "messages"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Stable URL-safe identifier. Do not change after publication unless necessary."
    },
    "subject": { "type": "string", "minLength": 1 },
    "summary": { "type": "string" },
    "description": { "type": "string", "minLength": 1 },
    "correspondenceWith": { "type": "string" },
    "organisation": { "type": "string" },
    "category": { "type": "string" },
    "topics": { "type": "array", "items": { "type": "string" } },
    "fromDate": { "type": "string", "format": "date" },
    "toDate": { "type": "string", "format": "date" },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "description": "Semantic version of this published evidence thread."
    },
    "updatedAt": { "type": "string", "format": "date" },
    "evidenceStatus": { "type": "string" },
    "sourceTitle": { "type": "string" },
    "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "revisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["version", "date", "summary"],
        "properties": {
          "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
          "date": { "type": "string", "format": "date" },
          "summary": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["date", "body"],
        "properties": {
          "date": { "type": "string", "format": "date-time" },
          "fromName": { "type": "string" },
          "fromAddress": { "type": "string" },
          "to": { "type": "string" },
          "cc": { "type": "string" },
          "subject": { "type": "string" },
          "body": { "type": "string" },
          "attachments": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name"],
              "properties": {
                "name": { "type": "string" },
                "url": { "type": "string", "format": "uri", "pattern": "^https://" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}