# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OAUTH PROVIDER CONFIGURATION (Client & Backend):
# Backend and Client IDs/Secrets for Google, Facebook, Instagram (Meta), and Apple authentication.
# Enter your OAuth application credentials below:
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# Client-side exposed variables (if using client SDKs):
VITE_GOOGLE_CLIENT_ID=""
VITE_FACEBOOK_APP_ID=""
VITE_INSTAGRAM_CLIENT_ID=""
VITE_APPLE_CLIENT_ID=""

# STRIPE CONFIGURATION:
# Merchant processing for £9.99 Eligibility Check and £49.99/mo Statutory Restitution Service.
# Add your Stripe Secret Key (sk_test_... or sk_live_...) in AI Studio Secrets / Env.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_PRICE_ID_ELIGIBILITY_CHECK=""
STRIPE_PRICE_ID_MONTHLY_SUBSCRIPTION=""

# TEST_MODE: Set to "true" to allow benchmark test codes (e.g. ELIG-BUCKLER-1987, ELIG-8842-UK).
# In production, set to "false" to only accept authenticated certificates in the reviewed registry.
TEST_MODE="false"
